/*
 * Profiles: local, docker, awsbatch.
 *
 *   nextflow run main.nf -profile docker
 *   nextflow run main.nf -profile awsbatch -work-dir s3://BUCKET/work
 *
 * CONTAINER TAGS ARE NOT VERIFIED. They are parameters rather than hardcoded
 * because biocontainer build strings change and a stale tag fails at pull time
 * with an error that looks like a pipeline bug. Check each against
 * https://quay.io/organization/biocontainers before the first run, and pin
 * whatever you confirm. In particular the local analysis used REGENIE 4.1.3 and
 * the tag below may not match it; a version mismatch changes --vc-tests
 * behaviour, which is exactly the thing this pipeline measures.
 */

params {
    container_bcftools = 'quay.io/biocontainers/bcftools:1.19--h8b25389_0'
    container_plink2   = 'quay.io/biocontainers/plink2:2.00a5.10--h4ac6f70_0'
    container_regenie  = 'quay.io/biocontainers/regenie:3.6--h6a68c12_0'
    container_python   = 'python:3.11-slim'
}

process {
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

profiles {

    local {
        process.executor = 'local'
        process.container = null
        docker.enabled = false
        // assumes the rvb conda env is active
    }

    docker {
        process.executor = 'local'
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g) --ulimit nofile=10240:10240'
    }

    awsbatch {
        process.executor = 'awsbatch'
        process.queue    = params.batch_queue ?: 'rvb-queue'
        aws.region       = params.aws_region  ?: 'us-east-1'
        aws.batch.cliPath = '/home/ec2-user/miniconda/bin/aws'
        aws.batch.maxParallelTransfers = 4

        // SLICE streams from a public HTTPS endpoint rather than S3, so these
        // tasks need egress. The 1000G data is also on AWS Open Data at
        // s3://1000genomes, which would be cheaper and faster from Batch;
        // switching params.vcf_base to the s3:// path is the obvious
        // optimization and has not been done or tested.
        process {
            withName: SLICE      { cpus = 1; memory = '4 GB'  }
            withName: ANNOTATE   { cpus = 1; memory = '4 GB'  }
            withName: BUILD_PGEN { cpus = 2; memory = '16 GB' }
            withName: ASSOC      { cpus = 4; memory = '8 GB'  }
        }
    }
}

timeline { enabled = true; file = "${params.outdir}/timeline.html" ; overwrite = true }
report   { enabled = true; file = "${params.outdir}/report.html"   ; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/trace.txt"     ; overwrite = true }
